# Public origin used inside QR codes. Must be reachable from a guest phone.
# Production example: https://kixclicks.vercel.app
NEXT_PUBLIC_SITE_URL=

# Server-only Vercel Blob token. Create a Blob store in the Vercel dashboard,
# then copy the read/write token here. Never expose this in client code.
BLOB_READ_WRITE_TOKEN=
