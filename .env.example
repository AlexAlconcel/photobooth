# Public origin used inside QR codes. Must be reachable from a guest phone.
# Production example: https://kixclicks.vercel.app
NEXT_PUBLIC_SITE_URL=https://kixclicks.vercel.app

# Required on Vercel for guest QR scans (serverless cannot keep photos in memory).
# Vercel dashboard → Storage → Create Blob store → Connect to this project.
# Vercel adds BLOB_READ_WRITE_TOKEN automatically on deploy. For local testing,
# copy the token from the store settings into .env.local. Never expose in client code.
BLOB_READ_WRITE_TOKEN=
