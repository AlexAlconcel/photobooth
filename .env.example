# Public origin used inside QR codes. Must be reachable from a guest phone.
NEXT_PUBLIC_SITE_URL=https://kixclicks.vercel.app

# Vercel Blob (connected store — OIDC, no manual token required on deploy):
# - BLOB_STORE_ID — added when you connect the store to this project
# - VERCEL_OIDC_TOKEN — short-lived; injected on Vercel (or `vercel env pull` locally)
# - BLOB_WEBHOOK_PUBLIC_KEY — for presigned client uploads (not used by this app)
#
# Optional fallback for local dev without OIDC:
# BLOB_READ_WRITE_TOKEN=

# Secures /api/cron/cleanup-shares (Vercel Cron sends Authorization: Bearer <CRON_SECRET>).
# Generate a long random string in the Vercel project Environment Variables UI.
CRON_SECRET=
